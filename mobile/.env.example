# Supabase Edge Function API URL
# Formato: https://SEU_PROJECT_REF.supabase.co/functions/v1/api
EXPO_PUBLIC_API_URL=https://SEU_PROJECT_REF.supabase.co/functions/v1/api

# App token (mesmo valor do secret APP_API_TOKEN na Edge Function)
# Enviado como Authorization: Bearer … e x-app-token
EXPO_PUBLIC_APP_API_TOKEN=troque-por-um-token-longo-e-aleatorio

# Force demo mode even if API URL is set (true|false)
# EXPO_PUBLIC_DEMO=true
